// 📦 Step 1: Import required Guava classes
import com.google.common.collect.*;
import com.google.common.primitives.*;
import java.util.*;

public class GuavaUtilitiesDemo {
    public static void main(String[] args) {

        // ───────────────────────────────────────────────
        // 1️⃣ PRIMITIVE UTILITIES (Ints, Longs, Doubles)
        // ───────────────────────────────────────────────
        System.out.println("=== 1️⃣ PRIMITIVES (Ints) ===");

        int[] arr = {1, 2, 3, 4, 5};
        List<Integer> intList = Ints.asList(arr); // Convert array → List
        System.out.println("Array to List: " + intList);

        int[] backArray = Ints.toArray(intList); // List → Array
        System.out.println("List to Array: " + Arrays.toString(backArray));

        System.out.println("Contains 3? " + Ints.contains(arr, 3));
        System.out.println("Min: " + Ints.min(arr));
        System.out.println("Max: " + Ints.max(arr));
        System.out.println("Joined String: " + Ints.join("-", arr));

        // ───────────────────────────────────────────────
        // 2️⃣ LIST UTILITIES
        // ───────────────────────────────────────────────
        System.out.println("\n=== 2️⃣ LIST UTILITIES ===");

        List<String> names = Lists.newArrayList("Alice", "Bob", "Charlie", "Diana", "Eve");
        System.out.println("Original List: " + names);

        List<String> reversed = Lists.reverse(names); // Reverse view
        System.out.println("Reversed List: " + reversed);

        List<List<String>> partitioned = Lists.partition(names, 2); // Divide into sublists
        System.out.println("Partitioned (size 2): " + partitioned);

        // ───────────────────────────────────────────────
        // 3️⃣ SET UTILITIES
        // ───────────────────────────────────────────────
        System.out.println("\n=== 3️⃣ SET UTILITIES ===");

        Set<Integer> setA = Sets.newHashSet(1, 2, 3);
        Set<Integer> setB = Sets.newHashSet(3, 4, 5);

        System.out.println("Set A: " + setA);
        System.out.println("Set B: " + setB);

        Set<Integer> union = Sets.union(setA, setB);
        Set<Integer> intersection = Sets.intersection(setA, setB);
        Set<Integer> difference = Sets.difference(setA, setB);

        System.out.println("Union: " + union);
        System.out.println("Intersection: " + intersection);
        System.out.println("Difference (A - B): " + difference);

        // ───────────────────────────────────────────────
        // 4️⃣ MAP UTILITIES
        // ───────────────────────────────────────────────
        System.out.println("\n=== 4️⃣ MAP UTILITIES ===");

        Map<String, Integer> fruits = Maps.newHashMap();
        fruits.put("Apple", 3);
        fruits.put("Banana", 5);
        fruits.put("Mango", 1);

        System.out.println("Original Map: " + fruits);

        // Filter values > 2
        Map<String, Integer> filtered = Maps.filterValues(fruits, v -> v > 2);
        System.out.println("Filtered (value > 2): " + filtered);

        // Transform values (multiply by 10)
        Map<String, Integer> transformed = Maps.transformValues(fruits, v -> v * 10);
        System.out.println("Transformed (value * 10): " + transformed);

        // ───────────────────────────────────────────────
        // 5️⃣ IMMUTABLE COLLECTIONS
        // ───────────────────────────────────────────────
        System.out.println("\n=== 5️⃣ IMMUTABLE COLLECTIONS ===");

        ImmutableList<String> immutableList = ImmutableList.of("Red", "Green", "Blue");
        ImmutableSet<Integer> immutableSet = ImmutableSet.of(10, 20, 30);
        ImmutableMap<String, Integer> immutableMap = ImmutableMap.of("A", 1, "B", 2);

        System.out.println("Immutable List: " + immutableList);
        System.out.println("Immutable Set: " + immutableSet);
        System.out.println("Immutable Map: " + immutableMap);

        // ───────────────────────────────────────────────
        // 6️⃣ ITERABLES UTILITIES
        // ───────────────────────────────────────────────
        System.out.println("\n=== 6️⃣ ITERABLES UTILITIES ===");

        Iterable<Integer> combined = Iterables.concat(Lists.newArrayList(1, 2), Lists.newArrayList(3, 4));
        System.out.println("Concatenated Iterables: " + combined);
        System.out.println("Contains 3? " + Iterables.contains(combined, 3));
        System.out.println("Size: " + Iterables.size(combined));

        // ───────────────────────────────────────────────
        // 7️⃣ COLLECTIONS2 UTILITIES
        // ───────────────────────────────────────────────
        System.out.println("\n=== 7️⃣ COLLECTIONS2 UTILITIES ===");

        Collection<Integer> nums = Lists.newArrayList(1, 2, 3, 4, 5, 6);
        Collection<Integer> evens = Collections2.filter(nums, n -> n % 2 == 0);
        System.out.println("Even Numbers: " + evens);

        Collection<Integer> doubled = Collections2.transform(nums, n -> n * 2);
        System.out.println("Doubled Numbers: " + doubled);

        // ───────────────────────────────────────────────
        // 8️⃣ COMBINING EVERYTHING TOGETHER
        // ───────────────────────────────────────────────
        System.out.println("\n=== 8️⃣ COMBINED EXAMPLE ===");

        // Step 1: Start with primitive array
        int[] numbers = {10, 20, 30, 40, 50, 60};
        List<Integer> numberList = Ints.asList(numbers);

        // Step 2: Partition into groups of 3
        List<List<Integer>> chunks = Lists.partition(numberList, 3);
        System.out.println("Chunks of 3: " + chunks);

        // Step 3: Reverse and double each number using Collections2
        List<Integer> reversedNums = Lists.reverse(numberList);
        Collection<Integer> doubledNums = Collections2.transform(reversedNums, n -> n * 2);
        System.out.println("Reversed & Doubled: " + doubledNums);

        // Step 4: Convert to Immutable
        ImmutableList<Integer> finalList = ImmutableList.copyOf(doubledNums);
        System.out.println("Immutable Final List: " + finalList);
    }
}
