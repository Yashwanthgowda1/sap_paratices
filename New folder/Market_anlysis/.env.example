# ARTHA — environment template. Copy to .env and fill what you want preset.
# LLM keys can ALSO be entered live in the dashboard sidebar (they override .env).

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default model per provider (optional overrides)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro

# Macro defaults (used when live scrape unavailable). Update after each RBI MPC.
RBI_REPO_RATE=6.50
CPI_INFLATION=4.80
GSEC_10Y=7.05

# Cache TTL for live market quotes, seconds
QUOTE_CACHE_TTL=60
