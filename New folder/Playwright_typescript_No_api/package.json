{
  "name": "hotstar-hybrid-framework",
  "version": "1.0.0",
  "description": "Hybrid Web + Android Playwright/Appium TypeScript framework — JioHotstar",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:mobile-chrome": "npx playwright test --project=mobile-chrome",
    "test:mobile-safari": "npx playwright test --project=mobile-safari",
    "test:hotstar": "npx playwright test tests/hotstar/",
    "test:hotstar:login": "npx playwright test tests/hotstar/e2e_login_home.spec.ts",
    "test:hotstar:search": "npx playwright test tests/hotstar/e2e_search_play.spec.ts",
    "test:hotstar:watchlist": "npx playwright test tests/hotstar/e2e_browse_watchlist.spec.ts",
    "test:android": "npx wdio run wdio.config.ts",
    "test:android:smoke": "npx wdio run wdio.config.ts --grep @smoke",
    "test:android:login": "npx wdio run wdio.config.ts --spec tests/android/hotstar/e2e_login_home.spec.ts",
    "test:android:search": "npx wdio run wdio.config.ts --spec tests/android/hotstar/e2e_search_play.spec.ts",
    "test:android:watchlist": "npx wdio run wdio.config.ts --spec tests/android/hotstar/e2e_browse_watchlist.spec.ts",
    "report": "npx playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "webdriverio": "^9.0.0"
  }
}
