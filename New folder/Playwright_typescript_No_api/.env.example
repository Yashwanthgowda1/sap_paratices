# Copy this file to .env and fill in values for your environment

# ── Web (Playwright) ─────────────────────────────────────────────────────────
BASE_URL=https://www.hotstar.com/in
HEADLESS=true
SLOW_MO=0

# ── Android (Appium) ─────────────────────────────────────────────────────────
# ADB device name — run: adb devices
ANDROID_DEVICE=emulator-5554
# Android OS version on the device
ANDROID_VERSION=13.0
# Absolute or relative path to the .apk under test
ANDROID_APP_PATH=./apps/SauceLabs.apk
# Appium server — leave default unless you run a remote Grid
APPIUM_HOST=localhost
APPIUM_PORT=4723
