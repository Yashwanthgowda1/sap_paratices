{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginResponse",
  "type": "object",
  "required": ["token", "user"],
  "properties": {
    "token": {"type": "string"},
    "user": {
      "type": "object",
      "required": ["id", "email"],
      "properties": {
        "id": {"type": "string"},
        "email": {"type": "string", "format": "email"},
        "name": {"type": "string"},
        "subscription": {"type": "string"}
      }
    }
  }
}
