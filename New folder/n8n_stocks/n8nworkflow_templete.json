{
  "name": "MarketDeep Receiver",
  "nodes": [
    {
      "parameters": {
        "path": "marketdeep",
        "options": {}
      },
      "id": "Webhook_Node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookDescription": "Receives MarketDeep AI POST requests"
    },
    {
      "parameters": {
        "functionCode": "return [{ json: { message: 'Received successfully', input: $json } }];"
      },
      "id": "Function_Log",
      "name": "Log Input",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [550, 300]
    },
    {
      "parameters": {
        "respondWith": "lastNode"
      },
      "id": "Respond",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Log Input", "type": "main", "index": 0 }]] },
    "Log Input": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
